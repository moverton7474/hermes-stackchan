# Bridge Server
BRIDGE_PORT=8000
OTA_PORT=8003
BRIDGE_HOST=0.0.0.0

# GVC Hermes Authentication
# Get this by logging into voice.visionaryai.marketing and extracting the session cookie
# Or use an API key if available
HERMES_ENDPOINT=https://voice.visionaryai.marketing/api/realtime/hermes
HERMES_AUTH_TOKEN=

# OpenAI Realtime (defaults from Hermes, override if needed)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Robot Identity
ROBOT_NAME=hermes-stackchan-01
ROBOT_TIMEZONE_OFFSET=-300

# Debug
LOG_LEVEL=info
