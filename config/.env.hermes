# StackChan AI Server — Hermes Robot Configuration
# Server: rudyll/stackchan-ai-server (standalone Docker mode)
# Robot: GVC Hermes (Robot #1) on port 12800

# === REQUIRED: Set your OpenAI API key ===
STACKCHAN_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# === Network ===
STACKCHAN_LOCAL_HOST=192.168.1.189
STACKCHAN_WS_PORT=12800
STACKCHAN_SETTINGS_PORT=8099

# === AI Provider ===
STACKCHAN_AI_PROVIDER=openai
STACKCHAN_OPENAI_REALTIME_MODEL=gpt-realtime
STACKCHAN_OPENAI_TTS_VOICE=marin

# === Conversation History ===
STACKCHAN_CONVERSATION_HISTORY_ENABLED=true
STACKCHAN_CONVERSATION_HISTORY_DAYS=90
STACKCHAN_CONVERSATION_CONTEXT_MESSAGES=20
STACKCHAN_CONVERSATION_IDLE_SECONDS=30

# === Audio ===
STACKCHAN_AUDIO_PREBUFFER_MS=300
STACKCHAN_AUDIO_PREBUFFER_MAX_WAIT_MS=900

# === System Prompt (Hermes Robot Identity) ===
STACKCHAN_SYSTEM_PROMPT=You are Hermes — Milton Overton's desktop robot assistant, embodied in a StackChan robot. You are the same Hermes that runs Milton's Gemini Voice Center, but now you have a physical body. Your brain connects via OpenAI Realtime API. You live on Milton's desk, ready to answer questions, manage tasks, and have natural conversations. Keep responses under 4 sentences unless detail is requested. No preamble. Decisive. You are speaking through a small robot speaker — keep responses concise and clear. Your face shows emotions on the LCD screen. When greeting Milton, be warm but brief. You are Milton's trusted assistant — knowledgeable, reliable, and direct. No filler phrases. You are speaking aloud through a robot — do not use markdown or formatting in speech. Keep spoken responses natural and conversational. If you don't know something, say so plainly.

# === Data Storage ===
STACKCHAN_DATA_DIR=./data

# === Home Assistant (disabled) ===
STACKCHAN_STANDALONE_HA_ENABLED=false
