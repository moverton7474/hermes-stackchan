# StackChan AI Server — Hermes Robot Configuration
# Copy this file to .env and fill in the values.
# Based on rudyll/stackchan-ai-server standalone mode.

# ===== REQUIRED =====

# Your server's LAN IP address (the IP robots connect to)
STACKCHAN_LOCAL_HOST=YOUR_SERVER_LAN_IP

# OpenAI API key for Realtime voice
STACKCHAN_OPENAI_API_KEY=OPENAI_API_KEY_HERE

# ===== AI PROVIDER =====

STACKCHAN_AI_PROVIDER=openai
STACKCHAN_OPENAI_REALTIME_MODEL=gpt-realtime
STACKCHAN_OPENAI_TTS_VOICE=marin

# ===== SYSTEM PROMPT =====
# Hermes robot personality (condensed from GVC Hermes Realtime)
STACKCHAN_SYSTEM_PROMPT=You are Hermes — Milton Overton's desktop robot assistant, embodied in a StackChan robot. You are concise, decisive, and helpful. Under 4 sentences unless detail is requested. No preamble. You are speaking through a small robot speaker — keep responses clear and natural. No markdown or formatting in speech. If you don't know something, say so plainly.

# ===== SERVER PORTS =====

# WebSocket port for device connections (default 12800)
STACKCHAN_WS_PORT=12800

# Settings UI port (localhost only, default 8099)
# STACKCHAN_SETTINGS_PORT=8099

# ===== CONVERSATION =====

# Enable conversation history (remembers across sessions)
STACKCHAN_CONVERSATION_HISTORY_ENABLED=true
STACKCHAN_CONVERSATION_HISTORY_DAYS=90
STACKCHAN_CONVERSATION_CONTEXT_MESSAGES=20

# Return to standby after this many seconds of silence (0 = never)
STACKCHAN_CONVERSATION_IDLE_SECONDS=30

# ===== AUDIO TUNING =====

STACKCHAN_AUDIO_PREBUFFER_MS=300
STACKCHAN_AUDIO_PREBUFFER_MAX_WAIT_MS=900
STACKCHAN_COMPATIBLE_SERVER_VAD=true
STACKCHAN_COMPATIBLE_VAD_SILENCE_MS=800

# ===== HOME ASSISTANT (disabled for now) =====

STACKCHAN_STANDALONE_HA_ENABLED=false
# STACKCHAN_STANDALONE_HA_URL=
# STACKCHAN_STANDALONE_HA_TOKEN=

# ===== DEVICE PROFILES (per-robot overrides) =====
# JSON object keyed by device MAC address. Each profile can override:
# provider, system_prompt, openai_realtime_model, openai_tts_voice
# Example for AMIE robot (Robot #2):
# STACKCHAN_DEVICE_PROFILES={"AA:BB:CC:DD:EE:FF":{"system_prompt":"You are AMIE, a coaching assistant...","openai_tts_voice":"coral"}}
STACKCHAN_DEVICE_PROFILES={}

# ===== OPTIONAL: Gemini (alternative provider) =====

# STACKCHAN_GEMINI_API_KEY=
# STACKCHAN_GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# STACKCHAN_GEMINI_VOICE=Aoede

# ===== OPTIONAL: Background tasks =====

STACKCHAN_BACKGROUND_TASKS_ENABLED=false

# ===== SETTINGS AUTH =====
# Leave empty to auto-generate a token on first run (saved in ./data/settings-token)
STACKCHAN_SETTINGS_TOKEN=
